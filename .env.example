# Google Calendar OAuth Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=https://homebase.skyy.studio/api/auth/google/callback

# Session & OAuth State Signing Secret (generate a strong 32+ byte random hex string for production)
AUTH_SECRET=replace_with_strong_random_hex_secret

# Public App URL & Allowed CORS Origins
APP_URL=https://homebase.skyy.studio
ALLOWED_ORIGINS=https://homebase.skyy.studio
